const express = require('express');
const TelegramBot = require('node-telegram-bot-api');
const axios = require('axios');

const app = express();
const token = ''; // Replace with your actual token
const bot = new TelegramBot(token, { polling: true });

// Helper: Log the file_id when you send an audio file to the bot
bot.on('audio', (msg) => {
    console.log(`\nNew song detected!`);
    console.log(`Title: ${msg.audio.title || 'Unknown'}`);
    console.log(`File ID: ${msg.audio.file_id}\n`);
});

// Main stream route
app.get('/stream/:fileId', async (req, res) => {
    try {
        const fileId = req.params.fileId;
        // Ask Telegram for the direct download URL
        const fileLink = await bot.getFileLink(fileId);

        // Fetch the file as a continuous data stream
        const response = await axios({
            method: 'get',
            url: fileLink,
            responseType: 'stream'
        });

        res.setHeader('Content-Type', 'audio/mpeg');
        // Pipe the Telegram stream directly to the web response
        response.data.pipe(res);
    } catch (error) {
        console.error('Streaming error:', error.message);
        res.status(500).send('Failed to stream audio');
    }
});

app.listen(3000, () => {
    console.log('Server active on port 3000');
    console.log('Send an MP3 to your Telegram bot to generate a File ID.');
});
